# Sao chép thành Backend/.env trong máy của bạn, KHÔNG đưa .env thật lên git/chat.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=quan_ly_quy_nhom
# Tạo chuỗi bí mật ngẫu nhiên >= 32 ký tự, ví dụ: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
